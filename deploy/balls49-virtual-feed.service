[Unit]
Description=Publish Virtual Football matches to the Balls49 website
After=network-online.target balls49-virtual.service
Wants=network-online.target balls49-virtual.service

[Service]
Type=simple
User=balls49
Group=balls49
WorkingDirectory=/home/balls49/virtualFootball
EnvironmentFile=/etc/balls49/virtual.env
ExecStart=/home/balls49/virtualFootball/.venv/bin/python /home/balls49/virtualFootball/publish_site_feed.py
Restart=on-failure
RestartSec=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
